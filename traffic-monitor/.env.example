# -------------------------------------------------------------
# MODE DETEKSI:
# - false : Khusus Miniatur Kendaraan (HotWheels/Mobil/Motor). Abaikkan Tangan, Laptop, HP, dll.
# - true  : Bebas (Mendeteksi Benda/Item Apapun di Maket)
# -------------------------------------------------------------
DETECT_ANY_OBJECT=false

# Sumber Kamera (IP Webcam HP / USB Webcam / ESP32-CAM)
CAMERA_SOURCE=http://192.168.1.50:8080/video

# Model YOLO11 & Confidence
MODEL_PATH=yolo11n.pt
CONFIDENCE_THRESHOLD=0.22
IOU_THRESHOLD=0.45

# Threshold Kemacetan (Jumlah Kendaraan)
THRESHOLD_LANCAR=5
THRESHOLD_MACET=10

# Integrasi Real-Time ke Dashboard Next.js (UrbanPulse)
ENABLE_DASHBOARD_SYNC=true
DASHBOARD_API_URL=http://localhost:3000/api/iot/telemetry
DEVICE_ID=YOLO-CV-TRAFFIC-01
INTERSECTION_ID=TRF-01
TELEMETRY_INTERVAL_SEC=1.5

# Web Stream Server untuk Visualisasi Kamera di Dashboard Web UI
ENABLE_STREAM_SERVER=true
STREAM_SERVER_PORT=8088
